{
  "name": "softether-tray",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "cleardev": "fuser -k -TERM 1420/tcp >/dev/null 2>&1 || true; sleep 0.3; fuser -k 1420/tcp >/dev/null 2>&1 || true; echo '[cleardev] port 1420 cleared'",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-autostart": "^2.0.0",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  }
}
