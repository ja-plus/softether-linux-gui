{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoftEther Tray",
  "version": "0.2.0",
  "identifier": "cn.softether.tray",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SoftEther Tray",
        "width": 1120,
        "height": 880,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "shortDescription": "SoftEther VPN 客户端托盘 GUI",
    "longDescription": "SoftEther VPN 的 Linux 托盘客户端：账号管理、连接状态、虚拟网卡与路由配置。内置官方 vpnclient 与 vpncmd，无需另行安装 SoftEther 客户端；通过 polkit 授权后连接/断开不再弹密码框。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": ["policykit-1 | pkexec"],
        "files": {
          "/usr/lib/softether-tray/client/vpnclient": "../vendor/softether-client/vpnclient",
          "/usr/lib/softether-tray/client/vpncmd": "../vendor/softether-client/vpncmd",
          "/usr/lib/softether-tray/client/hamcore.se2": "../vendor/softether-client/hamcore.se2",
          "/usr/lib/softether-tray/client/lang.config": "../vendor/softether-client/lang.config",
          "/usr/share/doc/softether-tray/SoftEther-LICENSE.txt": "../vendor/softether-client/ReadMeFirst_License.txt",
          "/usr/libexec/softether-tray/softether-tray-net": "../Tools/softether-tray-net",
          "/usr/share/polkit-1/actions/cn.softether.tray.net.policy": "../Tools/cn.softether.tray.net.policy",
          "/etc/polkit-1/rules.d/50-softether-tray.rules": "../Tools/50-softether-tray.rules"
        },
        "postInstallScript": "../Tools/deb-postinst.sh"
      }
    }
  }
}
